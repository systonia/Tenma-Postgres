{
    "name": "tenma/postgres",
    "description": "A Postgres server of the app's own on Tenma: started next to the app through a native plugin, stopped with it.",
    "type": "library",
    "license": [
        "MIT",
        "Apache-2.0"
    ],
    "require": {
        "php": ">=8.5"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.3",
        "tenma/stubs": "^0.2.0"
    },
    "bin": [
        "bin/tenma-postgres"
    ],
    "autoload": {
        "psr-4": {
            "Tenma\\Postgres\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tenma\\Postgres\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --testdox",
        "stan": "phpstan analyse"
    }
}
